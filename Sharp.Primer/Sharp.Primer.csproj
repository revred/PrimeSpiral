<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>false</OverrideHtmlAssetPlaceholders>
    <BlazorGenerateBootManifest>true</BlazorGenerateBootManifest>
    <BlazorWebAssemblyPreserveCollationData>false</BlazorWebAssemblyPreserveCollationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Sharc" Version="1.0.1-alpha" />
    <PackageReference Include="Sharc.Graph" Version="1.0.1-alpha" />
  </ItemGroup>

  <!-- Preserve Sharc assemblies from IL trimmer (accessed via JSInterop reflection) -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Sharp.Primer" />
    <TrimmerRootAssembly Include="Sharc" />
    <TrimmerRootAssembly Include="Sharc.Core" />
    <TrimmerRootAssembly Include="Sharc.Crypto" />
    <TrimmerRootAssembly Include="Sharc.Query" />
    <TrimmerRootAssembly Include="Sharc.Graph" />
    <TrimmerRootAssembly Include="Sharc.Graph.Surface" />
    <TrimmerRootAssembly Include="System.Runtime.InteropServices.JavaScript" />
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

</Project>
